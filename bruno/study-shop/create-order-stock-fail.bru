meta {
  name: create order stock fail
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "customerEmail": "qa-stock@studyshop.local",
    "forcePaymentFailure": false,
    "items": [
      {
        "productId": "prod-raro",
        "quantity": 2
      }
    ]
  }
}

vars:pre-request {
  baseUrl: http://localhost:11001
}

script:post-response {
  bru.setVar("stockFailOrderId", res.body.orderId);
}

assert {
  res.status: eq 200
  res.body.orderId: isNotEmpty
}
