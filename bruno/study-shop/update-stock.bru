meta {
  name: update stock
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/products/{{productId}}/stock
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "quantity": 20
  }
}

vars:pre-request {
  baseUrl: http://localhost:10001
  productId: prod-mouse
}

assert {
  res.status: eq 200
}
