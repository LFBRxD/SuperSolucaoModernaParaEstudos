meta {
  name: create order
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "customerEmail": "qa@studyshop.local",
    "forcePaymentFailure": false,
    "items": [
      {
        "productId": "prod-mouse",
        "quantity": 1
      }
    ]
  }
}

vars:pre-request {
  baseUrl: http://localhost:11001
}

script:post-response {
  bru.setVar("orderId", res.body.orderId);
  bru.setVar("pollCount", "0");
}

assert {
  res.status: eq 200
  res.body.orderId: isNotEmpty
}
