meta {
  name: login
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "username": "qa",
    "password": "qa123"
  }
}

vars:pre-request {
  baseUrl: http://localhost:11001
}

script:post-response {
  bru.setVar("accessToken", res.body.accessToken);
}

assert {
  res.status: eq 200
}
